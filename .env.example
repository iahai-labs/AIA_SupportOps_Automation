APP_NAME=AIA SupportOps Automation
APP_VERSION=0.10.1
ENVIRONMENT=development
ROOT_PATH=
DATABASE_URL=postgresql+psycopg://supportops:supportops@localhost:5432/supportops

DEMO_SAFE_MODE=false
DEMO_ALLOW_EXTERNAL_AI=false
DEMO_ALLOW_EXTERNAL_AUTOMATION=false

AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=
AI_TIMEOUT_SECONDS=15

N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
AUTOMATION_TIMEOUT_SECONDS=5
AUTOMATION_MAX_ATTEMPTS=3
